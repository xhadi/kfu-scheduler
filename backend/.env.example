# Database connection string
# Default: sqlite:///courses.db (local SQLite)
# For production: postgresql://... from Supabase (or any other PostgreSQL provider)
DATABASE_URL=sqlite:///courses.db

# Default Hijri term code for the scraper
TERM_CODE=144810

# Minimum section count threshold for static HTML source validation
MIN_SECTIONS_THRESHOLD=1000

# Telegram bot token for scrape failure alerts (optional)
TELEGRAM_BOT_TOKEN=

# Telegram chat ID for receiving alerts (admin) (optional)
ADMIN_CHAT_ID=
