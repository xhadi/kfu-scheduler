# Database connection string
# Default: sqlite:///courses.db (local SQLite)
# For production: postgresql://user:pass@host:6543/dbname (Supabase Transaction mode)
DATABASE_URL=sqlite:///courses.db

# Default Hijri term code for the scraper
TERM_CODE=144810

# Minimum section count for static HTML source to be considered valid
MIN_SECTIONS_THRESHOLD=1000

# Telegram bot token for scrape failure alerts
TELEGRAM_BOT_TOKEN=

# Telegram chat ID for receiving alerts (admin)
ADMIN_CHAT_ID=
