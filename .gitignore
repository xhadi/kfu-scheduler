# ==========================================
# VS Code Rules
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# ==========================================
# Global / OS Rules
# ==========================================
.DS_Store
Thumbs.db
*.log

# ==========================================
# Firebase Rules
# ==========================================
.firebase/
*ui.log

# ==========================================
# Backend (Python / FastAPI / DB) Rules
# ==========================================
backend/venv/
backend/.venv/
backend/env/
backend/scraper/data/
backend/*.db
backend/.env
__pycache__/
*.py[cod]

# ==========================================
# Frontend (Node / React / Vite) Rules
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.local

# ==========================================
# Agent docs and graphs
# ==========================================
docs/
graphify-out/
.graphifyignore
AGENTS.md

# ==========================================
# Agent Workspace Cache
# ==========================================
frontend/.agents/.worktrees/
.worktrees/
