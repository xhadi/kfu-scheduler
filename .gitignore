# ==========================================
# VS Code Rules
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# ==========================================
# Global / OS Rules
# ==========================================
.DS_Store
Thumbs.db
*.log

# ==========================================
# Firebase Rules
# ==========================================
.firebase/
*ui.log

# ==========================================
# Backend (Python / FastAPI / SQLite) Rules
# ==========================================
backend/venv/
backend/.venv/
backend/env/
backend/scraper/data/
backend/*.db
backend/*.sqlite3
backend/.env
# Python caching is made GLOBAL
__pycache__/
*.py[cod]

# ==========================================
# Frontend (Node / React) Rules
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.local